# ==========================================
# EMAIL AUTOMATION CONFIGURATION
# ==========================================

# 1. Your Email Credentials (Gmail App Password)
# NOTE: Do NOT use your normal Gmail password!
# Generate an App Password in Google Account -> Security -> 2-Step Verification -> App Passwords
SENDER_NAME="Your Name"
SENDER_EMAIL="your_email@gmail.com"
SENDER_PASSWORD="xxxx xxxx xxxx xxxx"

# SMTP Settings (Defaults configured for Gmail)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_TLS=true

# 2. AI Personalization (Optional)
# Get a free Gemini API key at: https://aistudio.google.com/
# If left empty, system automatically uses intelligent smart templates!
GEMINI_API_KEY=""

# 3. Your Profile & Portfolio (Included in emails)
YOUR_UNIVERSITY="Your University Name"
YOUR_DEGREE="B.Tech Computer Science"
YOUR_GRADUATION_YEAR="2026"
YOUR_SKILLS="Python, React, TypeScript, FastAPI, Machine Learning, SQL"
YOUR_PORTFOLIO_URL="https://github.com/yourprofile"
YOUR_LINKEDIN_URL="https://linkedin.com/in/yourprofile"

# 4. Attachment (PDF Resume)
# Put your resume in the 'resume' folder and update the filename here
ATTACHMENT_PATH="resume/resume.pdf"

# 5. Safety & Anti-Spam Delays
# Sends with a random delay between MIN and MAX seconds to appear natural
MIN_DELAY_SECONDS=35
MAX_DELAY_SECONDS=75
# Maximum emails to send in a 24-hour window to protect sender reputation
MAX_DAILY_EMAILS=25
